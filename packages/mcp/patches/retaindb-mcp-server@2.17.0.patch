+async function searchSharedKnowledge({ project, query, id, top_k, include_memories, include_graph, search_all, tags }) {
+  if (!query?.trim() || id || include_memories || include_graph || (search_all && project !== undefined)) {
+    return sharedKnowledgeError("Shared or tagged search requires a query and cannot include memory lookup or graph expansion. Omit project when search_all is set.", "KNOWLEDGE_SEARCH_ONLY");
