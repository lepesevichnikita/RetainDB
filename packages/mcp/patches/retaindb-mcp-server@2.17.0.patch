+  if (tags?.length && (!Array.isArray(applied) || applied.length !== tags.length || tags.some((tag, index) => applied[index] !== tag))) {
+    return sharedKnowledgeError("The RetainDB backend did not apply the requested tags.", "TAG_FILTER_UNSUPPORTED");
+  }
