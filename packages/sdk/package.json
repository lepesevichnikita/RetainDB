{
  "name": "@retaindb/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for RetainDB — add persistent memory to your AI agents",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./ai-sdk": {
      "import": { "types": "./dist/adapters/ai-sdk.d.ts", "default": "./dist/adapters/ai-sdk.js" },
      "require": { "types": "./dist/adapters/ai-sdk.d.cts", "default": "./dist/adapters/ai-sdk.cjs" }
    },
    "./tools": {
      "import": { "types": "./dist/adapters/tools.d.ts", "default": "./dist/adapters/tools.js" },
      "require": { "types": "./dist/adapters/tools.d.cts", "default": "./dist/adapters/tools.cjs" }
    },
    "./router": {
      "import": { "types": "./dist/router/memory-router.d.ts", "default": "./dist/router/memory-router.js" },
      "require": { "types": "./dist/router/memory-router.d.cts", "default": "./dist/router/memory-router.cjs" }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/adapters/ai-sdk.ts src/adapters/tools.ts src/router/memory-router.ts --format esm,cjs --dts --splitting false --out-dir dist",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "retaindb",
    "memory",
    "ai",
    "llm",
    "rag",
    "agents",
    "context"
  ],
  "author": "RetainDB",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/retaindb/retaindb"
  },
  "homepage": "https://retaindb.com",
  "bugs": {
    "url": "https://github.com/retaindb/retaindb/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "zod": "3.24.0"
  }
}
