generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ── Project ───────────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  orgId       String   @default("default")
  name        String
  slug        String   @unique
  description String?
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sources          Source[]
  documents        Document[]
  chunks           Chunk[]
  memories         Memory[]
  entityRelations  EntityRelation[]
  entities         Entity[]
  ingestionJobs    IngestionJob[]
  sessions         Session[]
  sharedContexts   SharedContext[]
  sharedFiles      SharedFile[]

  @@index([slug])
  @@map("projects")
}

// ── Sources & Documents ───────────────────────────────────────────────────────

enum SourceStatus {
  PENDING
  SYNCING
  SYNCED
  READY
  INDEXING
  ERROR
  DISABLED
  CONNECTING
}

enum SyncMode {
  MANUAL
  SCHEDULED
  REALTIME
}

enum SourceVersionStatus {
  STAGED
  PROMOTING
  ACTIVE
  SUPERSEDED
  FAILED
}

model Source {
  id              String       @id @default(uuid())
  orgId           String       @default("default")
  projectId       String
  name            String
  type            String       // "github" | "web" | "pdf" | "text" | "notion" | ...
  connectorType   String?      // alias / legacy field
  config          Json         @default("{}")
  status          SourceStatus @default(PENDING)
  activeVersionId String?
  lastSyncAt      DateTime?
  lastSyncError   String?
  syncError       String?
  syncSchedule    String?
  syncMode        SyncMode     @default(MANUAL)
  lastSyncStatus  String?
  deletedAt         DateTime?
  documentCount     Int        @default(0)
  chunkCount        Int        @default(0)
  lastSyncDurationMs Int?
  syncErrorCount     Int      @default(0)
  restoreUntil       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents Document[]
  versions  SourceVersion[]
  syncJobs  SyncJob[]
  evidence  Evidence[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([status])
  @@map("sources")
}

model SourceVersion {
  id            String   @id @default(uuid())
  sourceId      String
  orgId         String
  projectId     String?
  versionNumber Int
  status        SourceVersionStatus @default(STAGED)
  documentCount Int      @default(0)
  chunkCount    Int      @default(0)
  partialFailure Boolean  @default(false)
  warningCodes  String[] @default([])
  errorCode     String?
  errorMessage  String?
  syncJobId     String?
  promotedAt    DateTime?
  supersededAt  DateTime?
  failedAt      DateTime?
  restoreUntil  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  source    Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([sourceId, versionNumber])
  @@index([sourceId, status])
  @@map("source_versions")
}

enum DocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  READY
  ERROR
  EXCLUDED
}

model Document {
  id              String         @id @default(uuid())
  sourceId        String
  sourceVersionId String?
  projectId       String?
  externalId      String?
  title           String
  path            String?
  mimeType        String?
  contentHash     String?
  content         String?
  language        String?
  tokens          Int            @default(0)
  status          DocumentStatus @default(PENDING)
  parseError      String?
  webUrl          String?
  metadata        Json           @default("{}")
  indexedAt       DateTime?
  lastModified    DateTime?
  deletedAt         DateTime?
  chunkingStrategy  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  chunks        Chunk[]
  entities      Entity[]
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source        Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceVersion SourceVersion? @relation(fields: [sourceVersionId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([sourceVersionId])
  @@index([contentHash])
  @@index([sourceId, contentHash])
  @@index([status])
  @@map("documents")
}

// ── Chunks & Embeddings ───────────────────────────────────────────────────────

model Chunk {
  id              String                 @id @default(uuid())
  documentId      String
  projectId       String?
  chunkIndex      Int?
  chunkOrder      Int?
  chunkType       String?
  content         String
  contentHash     String?
  searchContent   String?
  tokens          Int                    @default(0)
  metadata        Json                   @default("{}")
  embedding       Unsupported("vector")?
  keywords        String[]               @default([])
  importanceScore Float                  @default(0.0)
  parentChunkId   String?
  sectionPath     String?
  headingPath     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentChunk   Chunk?        @relation("ChunkHierarchy", fields: [parentChunkId], references: [id])
  childChunks   Chunk[]       @relation("ChunkHierarchy")
  embeddings    Embedding[]
  chunkMemories ChunkMemory[]
  memories      Memory[]      @relation("MemorySourceChunk")
  entityMentions EntityMention[]
  entityRelationMentions EntityRelationMention[]
  entityRelationSources  EntityRelation[] @relation("EntityRelationSource")

  @@index([documentId])
  @@index([contentHash])
  @@index([parentChunkId])
  @@map("chunks")
}

model Embedding {
  id          String                @id @default(uuid())
  chunkId     String
  model       String
  dimensions  Int
  vector      Unsupported("vector")
  createdAt   DateTime              @default(now())

  chunk Chunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chunkId])
  @@index([model])
  @@map("embeddings")
}

// ── Memory ────────────────────────────────────────────────────────────────────

model Memory {
  id             String                 @id @default(uuid())
  projectId      String?
  orgId          String?                @default("default")
  userId         String?
  sessionId      String?
  agentId        String?
  taskId         String?

  memoryType     String                 @default("factual")
  content        String
  embedding      Unsupported("vector")?
  metadata       Json                   @default("{}")
  scope          String                 @default("USER")

  importance     Float                  @default(0.5)
  isActive       Boolean                @default(true)
  accessCount    Int                    @default(0)
  lastAccessedAt DateTime?
  recallCount    Int                    @default(0)
  expiresAt      DateTime?

  documentDate   DateTime?
  eventDate      DateTime?
  entityMentions String[]               @default([])
  confidence     Float                  @default(0.8)
  sourceChunkId  String?
  version        Int                    @default(1)
  validFrom      DateTime?              @default(now())
  validUntil     DateTime?
  supersededBy   String?

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  project              Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceChunk          Chunk?          @relation("MemorySourceChunk", fields: [sourceChunkId], references: [id], onDelete: SetNull)
  supersededByMemory   Memory?         @relation("MemoryVersionChain", fields: [supersededBy], references: [id], onDelete: SetNull)
  supersedes           Memory[]        @relation("MemoryVersionChain")
  outgoingRelations    MemoryRelation[] @relation("MemoryFrom")
  incomingRelations    MemoryRelation[] @relation("MemoryTo")
  chunkMemories        ChunkMemory[]

  @@index([projectId])
  @@index([orgId])
  @@index([userId])
  @@index([sessionId])
  @@index([agentId])
  @@index([taskId])
  @@index([memoryType])
  @@index([scope])
  @@index([isActive])
  @@index([expiresAt])
  @@index([validFrom, validUntil])
  @@index([confidence])
  @@index([supersededBy])
  @@map("memories")
}

model MemoryRelation {
  id           String   @id @default(uuid())
  fromMemoryId String
  toMemoryId   String
  relationType String
  confidence   Float    @default(0.8)
  reasoning    String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  fromMemory Memory @relation("MemoryFrom", fields: [fromMemoryId], references: [id], onDelete: Cascade)
  toMemory   Memory @relation("MemoryTo", fields: [toMemoryId], references: [id], onDelete: Cascade)

  @@unique([fromMemoryId, toMemoryId, relationType])
  @@index([fromMemoryId])
  @@index([toMemoryId])
  @@map("memory_relations")
}

model ChunkMemory {
  id       String @id @default(uuid())
  chunkId  String
  memoryId String

  chunk  Chunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([chunkId, memoryId])
  @@map("chunk_memories")
}

// ── Entities ──────────────────────────────────────────────────────────────────

model Entity {
  id         String                 @id @default(uuid())
  documentId String?
  projectId  String?
  name       String
  type       String                 // PERSON | ORG | PLACE | CONCEPT | ...
  entityType String?
  description String?
  aliases    String[]               @default([])
  embedding  Unsupported("vector")?
  isManual   Boolean                @default(true)
  // Provenance of this node: manual | extracted | import. isManual is derived from it (CHECK in the migration).
  origin     String                 @default("manual")
  metadata   Json                   @default("{}")
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  document         Document?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outgoingRelations EntityRelation[] @relation("EntityFrom")
  incomingRelations EntityRelation[] @relation("EntityTo")
  mentions EntityMention[]
  claims   Claim[]

  @@unique([projectId, name, entityType])
  @@index([projectId])
  @@index([type])
  @@map("entities")
}

model EntityRelation {
  id           String   @id @default(uuid())
  projectId    String?
  fromEntityId String
  toEntityId   String
  relationType String
  // Manual prior only: extraction and import never write it (machine confidence comes from active claims).
  weight       Float    @default(1.0)
  metadata     Json     @default("{}")
  isManual     Boolean  @default(true)
  // Provenance of this edge: manual | extracted | import. isManual is derived from it (CHECK in the migration).
  origin       String   @default("manual")
  sourceChunkId String?
  createdAt    DateTime @default(now())

  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromEntity Entity   @relation("EntityFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   Entity   @relation("EntityTo", fields: [toEntityId], references: [id], onDelete: Cascade)
  sourceChunk Chunk?  @relation("EntityRelationSource", fields: [sourceChunkId], references: [id], onDelete: SetNull)
  mentions   EntityRelationMention[]
  claims     Claim[]

  @@unique([fromEntityId, toEntityId, relationType])
  @@index([projectId])
  @@index([sourceChunkId])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([relationType])
  @@map("entity_relations")
}

model EntityMention {
  entityId    String
  chunkId     String
  description String?
  embedding   Unsupported("vector")?
  entity      Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  chunk       Chunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([entityId, chunkId])
  @@index([chunkId])
  @@map("entity_mentions")
}

model EntityRelationMention {
  relationId String
  chunkId    String
  relation   EntityRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  chunk      Chunk          @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([relationId, chunkId])
  @@index([chunkId])
  @@map("entity_relation_mentions")
}

// ── Evidence & claims ─────────────────────────────────────────────────────────
// One evidence row per (source, content text). A claim is an assertion about content, not about a
// source version: it is active while the source's active version still holds that content digest.
// The partial unique indexes and the origin CHECK are raw SQL in the knowledge-engine migrations.

model Evidence {
  id                 String  @id @default(uuid())
  sourceId           String
  contentDigest      String
  text               String
  documentExternalId String?
  path               String?
  url                String?

  source Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  claims Claim[]

  @@unique([sourceId, contentDigest])
  @@map("evidence")
}

model Claim {
  id         String   @id @default(uuid())
  evidenceId String
  entityId   String?
  relationId String?
  confidence Float
  origin     String
  createdAt  DateTime @default(now())

  evidence Evidence        @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  entity   Entity?         @relation(fields: [entityId], references: [id], onDelete: SetNull)
  relation EntityRelation? @relation(fields: [relationId], references: [id], onDelete: SetNull)

  @@index([evidenceId])
  @@index([entityId])
  @@index([relationId])
  @@map("claims")
}

// ── Sessions & Messages ───────────────────────────────────────────────────────

model Session {
  id        String    @id @default(uuid())
  projectId String?
  orgId     String    @default("default")
  sessionId     String?
  userId        String?
  agentId       String?
  taskId        String?
  title         String?
  lastMessageAt DateTime?
  messageCount  Int       @default(0)
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId])
  @@index([userId])
  @@index([sessionId])
  @@map("sessions")
}

model Message {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  content   String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}

// ── Shared Context ────────────────────────────────────────────────────────────

model SharedContext {
  id          String    @id @default(uuid())
  projectId   String?
  orgId       String    @default("default")
  title       String?
  sessionId   String?
  userId      String?
  shareUrl    String?
  memories    Json      @default("[]")
  messages    Json      @default("[]")
  chunks      Json      @default("[]")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  accessCount Int       @default(0)

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([shareUrl])
  @@map("shared_contexts")
}

// ── SyncJob ───────────────────────────────────────────────────────────────────

model SyncJob {
  id              String    @id @default(uuid())
  sourceId        String
  sourceVersionId String?
  type            String    @default("INCREMENTAL")
  status          String    @default("PENDING")
  progress        Float     @default(0)
  traceId         String?
  parentTraceId   String?
  errorMessage    String?
  errorCode       String?
  startedAt       DateTime?
  completedAt     DateTime?
  documentsTotal  Int       @default(0)
  documentsIndexed Int      @default(0)
  documentsFailed Int       @default(0)
  bytesProcessed  BigInt    @default(0)
  retryCount      Int       @default(0)
  logs            Json      @default("[]")
  partialFailure  Boolean   @default(false)
  warningCodes    String[]  @default([])
  createdAt       DateTime  @default(now())

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([status])
  @@map("sync_jobs")
}

// ── Ingestion ─────────────────────────────────────────────────────────────────

model IngestionJob {
  id         String   @id @default(uuid())
  projectId  String?
  sourceId   String?
  status     String   @default("pending")
  type       String
  payload    Json     @default("{}")
  result     Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([type])
  @@map("ingestion_jobs")
}

// ── API Idempotency ───────────────────────────────────────────────────────────

model ApiIdempotency {
  id             String   @id @default(uuid())
  orgId          String   @default("default")
  endpoint       String
  idempotencyKey String
  requestHash    String
  statusCode     Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([orgId, endpoint, idempotencyKey])
  @@index([expiresAt])
  @@map("api_idempotency")
}

// ── Shared File Storage ───────────────────────────────────────────────────────

model SharedFile {
  id          String    @id @default(uuid())
  orgId       String    @default("default")
  projectId   String?
  userId      String?
  agentId     String?
  path        String
  name        String
  mimeType    String?
  size        BigInt    @default(0)
  storageKey  String
  scope       String    @default("PROJECT")
  isPublic    Boolean   @default(false)
  contentHash String?
  metadata    Json      @default("{}")
  memoryId    String?
  memoryIds   String[]  @default([])
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([orgId, path])
  @@index([orgId, scope])
  @@index([orgId, agentId])
  @@index([projectId])
  @@index([deletedAt])
  @@map("shared_files")
}

// ── Agent Tasks (browser automation) ─────────────────────────────────────────

model AgentTask {
  id           String    @id @default(uuid())
  orgId        String    @default("default")
  userId       String    @default("")
  name         String
  goal         String
  outputSchema Json      @default("{}")
  template     String?
  schedule     String?
  options      Json      @default("{}")
  credentials  Json      @default("[]")
  webhookUrl   String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  runs         AgentRun[]

  @@index([orgId])
  @@map("agent_tasks")
}

model AgentRun {
  id           String    @id @default(uuid())
  taskId       String?
  orgId        String    @default("default")
  userId       String    @default("")
  goal         String
  plan         Json?
  result       Json?
  tokensUsed   Int       @default(0)
  status       String    @default("PLANNING")
  totalSteps   Int       @default(0)
  pagesVisited Int       @default(0)
  costUsd      Float     @default(0)
  hitlMessage  String?
  errorMsg     String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  task         AgentTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  steps        AgentRunStep[]

  @@index([orgId])
  @@index([taskId])
  @@index([status])
  @@map("agent_runs")
}

model AgentRunStep {
  id          String   @id @default(uuid())
  runId       String
  stepIndex   Int
  type        String
  description String   @default("")
  input       Json     @default("{}")
  output      Json     @default("{}")
  screenshot  String?
  confidence  Float    @default(0)
  durationMs  Int      @default(0)
  error       String?
  createdAt   DateTime @default(now())

  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("agent_run_steps")
}

model PageCache {
  id          String   @id @default(uuid())
  orgId       String   @default("default")
  url         String
  title       String   @default("")
  content     String   @default("")
  html        String   @default("")
  contentHash String?
  links       Json     @default("[]")
  screenshot  String?
  lastFetched DateTime @default(now())
  expiresAt   DateTime @default(dbgenerated("NOW() + INTERVAL '1 day'"))

  @@unique([orgId, url])
  @@index([expiresAt])
  @@map("page_cache")
}

model AgentCredential {
  id        String   @id @default(uuid())
  orgId     String   @default("default")
  name      String
  domain    String
  encrypted Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@map("agent_credentials")
}

// ── User-Agent Persistent Memory ──────────────────────────────────────────────

model UserAgentMemory {
  id                 String   @id @default(uuid())
  userId             String
  orgId              String?
  agentPersonality   String   @default("helpful, thoughtful, curious, systematic")
  learnedPreferences Json     @default("{}")
  selfNotes          String   @default("")
  interactionCount   Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("user_agent_memories")
}

model AgentResearchSession {
  id             String   @id @default(uuid())
  userId         String
  orgId          String?
  projectId      String?
  query          String
  answer         String   @default("")
  sources        Json     @default("[]")
  steps          Int      @default(0)
  durationMs     Int      @default(0)
  isDeepResearch Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([orgId])
  @@map("agent_research_sessions")
}

// ── Webhooks ──────────────────────────────────────────────────────────────────

model Webhook {
  id              String   @id @default(uuid())
  sourceId        String?
  orgId           String   @default("default")
  url             String
  events          String[] @default([])
  secret          String?
  isActive        Boolean  @default(true)
  lastTriggeredAt DateTime?
  lastDeliveredAt DateTime?
  lastStatusCode  Int?
  failureCount    Int      @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([orgId])
  @@map("webhooks")
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  webhookId   String
  event       String
  eventId     String?
  action      String   @default("deliver")
  attempt     Int      @default(1)
  durationMs  Int?
  payload     Json     @default("{}")
  statusCode  Int?
  responseBody String?
  errorMessage String?
  errorCode    String?
  traceId     String?
  parentTraceId String?
  deliveredAt DateTime? @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@map("webhook_deliveries")
}

model Package {
  id            String    @id @default(uuid())
  orgId         String    @default("default")
  projectId     String?
  ecosystem     String
  name          String
  version       String    @default("")
  registryUrl   String?
  autoSync      Boolean   @default(false)
  lastIndexedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([orgId, ecosystem, name])
  @@index([orgId])
  @@map("packages")
}

// ── Repository Indexing ───────────────────────────────────────────────────────
// Additive only. These tables keep repo-indexed source separate from the legacy
// memory, search, export, source and job surfaces, so repository content cannot
// leak through them. projectId is a plain column, not a relation, so this
// migration does not widen the existing Project model or its client surface.

model RepoIndexScope {
  id              String    @id @default(uuid())
  orgId           String    @default("default")
  projectId       String
  // Forge identity: provider host plus the provider's own repository id, never a
  // display name, so a renamed repository keeps one identity.
  repoHost        String
  repoExternalId  String
  worktreePath    String
  deviceId        String
  ref             String
  headCommit      String
  state           String    @default("active") // active | paused | withdrawn
  policyVersion   String
  pipelineVersion String
  activeGeneration Int      @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  grants      RepoIndexGrant[]
  generations RepoIndexGeneration[]
  paths       RepoIndexPath[]

  // Scope identity is normalised by the admin request schema before it reaches this key:
  // repoHost is lowercased and worktreePath has its trailing separators stripped.
  @@unique([orgId, repoHost, repoExternalId, worktreePath])
  @@index([projectId])
  @@index([state])
  @@map("repo_index_scopes")
}

model RepoIndexGrant {
  id        String    @id @default(uuid())
  scopeId   String
  // reader | uploader | connector | admin. Separate capabilities so an uploader
  // can submit its own work but cannot publish or read another cohort.
  kind      String
  principal String
  tokenHash String
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  scope RepoIndexScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  // A grant row is a credential, and revocation is its history. The partial unique index
  // `repo_index_grants_live_principal_key` in the migration allows one live grant per
  // (scopeId, kind, principal) and any number of revoked ones. Prisma cannot express a partial
  // index; adding revokedAt to a plain @@unique would let two live rows coexist, because
  // Postgres treats NULLs as distinct.
  @@index([scopeId, revokedAt])
  @@map("repo_index_grants")
}

model RepoIndexGeneration {
  id             String    @id @default(uuid())
  scopeId        String
  attemptId      String
  // Compare-and-swap fence: promotion is allowed only while baseGeneration still
  // equals the scope's activeGeneration, so an older writer cannot overwrite a
  // newer revision.
  baseGeneration Int
  generation     Int
  revision       String
  manifestDigest String
  partCount      Int
  // open | sealed | published | abandoned | failed
  status         String    @default("open")
  sealedAt       DateTime?
  publishedAt    DateTime?
  receiptDigest  String?
  failureCode    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  scope RepoIndexScope  @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  parts RepoIndexPart[]

  @@unique([scopeId, attemptId])
  @@unique([scopeId, generation])
  @@index([scopeId, status])
  @@map("repo_index_generations")
}

model RepoIndexPart {
  id             String    @id @default(uuid())
  generationId   String
  partNo         Int
  // Stored next to the outcome so the same scoped operation and canonical hash
  // replay the same result, while a changed payload is a conflict rather than a
  // silent overwrite.
  requestHash    String
  upsertCount    Int       @default(0)
  tombstoneCount Int       @default(0)
  // The deletions this part declares, by path. Persisted rather than counted, so the
  // publication guard can require every path a manifest drops to have been declared.
  tombstonePaths String[]  @default([])
  status         String    @default("accepted")
  receivedAt     DateTime  @default(now())

  generation RepoIndexGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([generationId, partNo])
  @@map("repo_index_parts")
}

model RepoIndexPath {
  id           String   @id @default(uuid())
  scopeId      String
  generationId String
  path         String
  digest       String
  lineStart    Int?
  lineEnd      Int?
  // present | tombstone
  state        String   @default("present")
  chunkId      String?
  updatedAt    DateTime @updatedAt

  scope RepoIndexScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([scopeId, path])
  @@index([scopeId, state])
  @@index([generationId])
  @@map("repo_index_paths")
}
